# 로컬 개발용 환경변수 예시. 실제 사용 시 .env 로 복사 후 값을 수정하세요.
# docker compose up -d mysql 후 아래 URL 그대로 사용하면 동작합니다.

DATABASE_URL=mysql+pymysql://tetris:tetrispass@localhost:3306/tetris
JWT_SECRET=dev-only-secret-change-me-please-use-32-byte-key
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8001,http://127.0.0.1:8000

# DATABASE_URL 을 비우거나 주석 처리하면 SQLite 폴백 (./tetris.db).
